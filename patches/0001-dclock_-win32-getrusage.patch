-    struct rusage ppt, cpt;
     struct timespec now;
     int ierr;
+    (void)ierr;
+
+#ifdef _WIN32
+    /* Windows has no getrusage(); use GetProcessTimes for this process.
+       Child-process CPU time is not aggregated on Windows and is omitted. */
+    FILETIME _dummy_creat, _dummy_exit, ft_kernel, ft_user;
+    if (GetProcessTimes(GetCurrentProcess(), &_dummy_creat, &_dummy_exit,
+                        &ft_kernel, &ft_user))
+    {
+        *vputim = win32_filetime_to_sec(&ft_user)
+                + win32_filetime_to_sec(&ft_kernel);
+    }
+    else
+    {
+        *vputim = 0.0;
+    }
+#else
+    struct rusage ppt, cpt;
 
