+#ifdef _WIN32
+#include <windows.h>
+static double win32_filetime_to_sec(const FILETIME *ft)
+{
+    ULARGE_INTEGER uli;
+    uli.LowPart  = ft->dwLowDateTime;
+    uli.HighPart = ft->dwHighDateTime;
+    return (double)uli.QuadPart / 1e7;   /* FILETIME counts 100ns ticks */
+}
+#else
 #include <sys/resource.h>  // getrusage()
+#endif
 #include <time.h>          // clock_gettime()
 
