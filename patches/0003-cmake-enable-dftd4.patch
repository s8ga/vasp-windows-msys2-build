diff --git a/cmake/CMakeLists/CMakeLists_root.txt b/cmake/CMakeLists/CMakeLists_root.txt
--- a/cmake/CMakeLists/CMakeLists_root.txt
+++ b/cmake/CMakeLists/CMakeLists_root.txt
@@ -343,8 +343,18 @@
   list(APPEND VASP_EXTERNAL_LIB_DIRS "${lib_dir}")
 endif()
 
-if(VASP_LIBBEEF OR VASP_DFTD4)
-  message(FATAL_ERROR "VASP_LIBBEEF and VASP_DFTD4 not yet supported through CMake.")
+if(VASP_DFTD4)
+  find_package(DFTD4 MODULE REQUIRED)
+  list(APPEND VASP_EXTERNAL_LIBS DFTD4::dftd4)
+  get_target_property(lib_path DFTD4::dftd4 IMPORTED_LOCATION)
+  if(lib_path)
+    get_filename_component(lib_dir ${lib_path} DIRECTORY)
+    list(APPEND VASP_EXTERNAL_LIB_DIRS "${lib_dir}")
+  endif()
+endif()
+
+if(VASP_LIBBEEF)
+  message(FATAL_ERROR "VASP_LIBBEEF not yet supported through CMake.")
 endif()
 
