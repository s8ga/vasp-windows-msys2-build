# Copy to local.env (gitignored) and adjust paths.
# Sourced by env_ucrt64.sh when present. Use MSYS /c/... form in UCRT64.

# export VASP_TARBALL='/c/Users/you/Downloads/vasp.6.6.0.tgz'

# Optional overrides (see README tunables):
# export TARGET_CPU=native
# export NUM_CORES=8
# export MSMPI_BIN='/c/Users/you/scoop/apps/msmpi/current'

# Optional VTST (default OFF = stock → build_work/stock/<stamp>/)
# Prefer: bash toolchain/scripts/install_vtst.sh
#   then source toolchain/install/setup_vtst (sets VTST_CODE_DIR if unset)
# export VASP_VTST=OFF
# export VASP_VTST=ON
# export VTST_CODE_DIR='/c/path/to/vtstcode6.6.0'   # manual override
# develop: omit WORK_DIR to use build_work/vtst/CURRENT (or stock/CURRENT)
# export WORK_DIR='/c/path/to/explicit/work/tree'

# Testsuite (toolchain/run_testsuite.sh)
# Resolve order: env_ucrt64 sources this file FIRST, then flavor/PKG_NAME, then paths.
# Use ${VAR:-…} so a CLI/exported value set before `bash run_testsuite.sh` still wins.
# export VASP_BUILD_FLAVOR="${VASP_BUILD_FLAVOR:-stock}"   # or: vtst / any scheme name
# export VASP_BUILD_FLAVOR="${VASP_BUILD_FLAVOR:-vtst}"
# export VASP_VTST="${VASP_VTST:-ON}"     # convenience when flavor unset → vtst
#   (conflict if VASP_BUILD_FLAVOR is set to something other than vtst)
# export PKG_NAME="${PKG_NAME:-vasp-6.6.0-msys2-portable-vtst}"  # optional exact package dir
# export VASP_PORTABLE_BIN="${VASP_PORTABLE_BIN:-/c/path/to/vasp-6.6.0-msys2-portable/bin}"
# export VASP_PORTABLE_BIN="${VASP_PORTABLE_BIN:-/c/path/to/vasp-6.6.0-msys2-portable-vtst/bin}"
# Exact flavor package only (stock=…-msys2-portable; other=…-portable-<flavor>).
# No silent cross-flavor fallback; stock never auto-adopts a sole …-portable-<other>.
# export TESTSUITE_RESOLVE_ONLY=1         # print resolved paths only (no runtest)
# export SKIP_WAN90=1                     # optional; passed through to upstream runtest
